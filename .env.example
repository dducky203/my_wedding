# Firebase Web configuration from Firebase Console > Project settings > Your apps.
# VITE_* values are public in the browser bundle. Never put service account keys
# or admin passwords here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Analytics is not enabled by the app).
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary unsigned image uploads. The preset restricts uploads to images
# and the wedding folder. Never prefix the API secret with VITE_.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=wedding_unsigned
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Server-only UID allowed to delete images (never prefix with VITE_).
FIREBASE_ADMIN_UID=
